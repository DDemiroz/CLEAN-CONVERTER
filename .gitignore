# Publish only the reviewed source/documentation set.
/*
!/.gitignore
!/app.py
!/splash_screen.py
!/CleanConverter.spec
!/pytest.ini
!/requirements.txt
!/requirements-dev.txt
!/requirements-lock.txt
!/scripts/
scripts/*
!scripts/prepare_bundle.py
!/README.md
!/README_TR.md
!/LICENSE.md
!/NOTICE.md
!/THIRD_PARTY_NOTICES.md
!/PUBLISHING_GUIDE.md
!/CHANGELOG.md
!/tests/
!/assets/
!/installer/
!/docs/
!/.github/
__pycache__/
*.py[cod]
.pytest_cache/
*.log
*.env
*.pfx
*.pem
assets/*
!assets/icon.png
!assets/icon.ico
installer/*
!installer/clean_converter.iss
!installer/version_info.txt
docs/*
!docs/screenshots/
docs/screenshots/*
!docs/screenshots/home.png
!docs/screenshots/link.png
!docs/screenshots/cover.png
!docs/screenshots/controls.png
